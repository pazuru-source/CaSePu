# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=False
FLASK_HOST=127.0.0.1
FLASK_PORT=5001
SECRET_KEY=your-secret-key-here-change-in-production

# Database Configuration
DATABASE_URL=sqlite:///instance/options_history.db

# Market Filtering Parameters (Default Values)
MIN_MARKET_CAP_BILLIONS=10
MAX_MARKET_CAP_BILLIONS=400
MAX_PEG_RATIO=1.5
MAX_PE_RATIO=25
MIN_PREMIUM_PERCENT_COLLATERAL=0.5
MIN_STOCK_PRICE=50.0
MAX_STOCK_PRICE=250.0
MIN_CHANCE_OF_PROFIT=0.80

# API/Data Fetching
MAX_RETRIES=3
RETRY_DELAY=2
RISK_FREE_RATE=0.04

# Concurrency
MAX_WORKERS=5

# Favorite Tickers (Comma-separated)
FAVORITE_TICKERS=IREN,CRWV,GLW,RKLB,ASTS,FLY

# Logging
LOG_LEVEL=INFO
